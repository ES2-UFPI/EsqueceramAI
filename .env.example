# Banco de dados. PostgreSQL recomendado; se vazio, usa SQLite local (esqueceram.db).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Armazenamento privado de imagens (bucket `item-images` do Supabase).
# Sem as duas variáveis, as imagens ficam em item_images (banco), atrás de sessão.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Origens permitidas na API REST (padrão: *)
CORS_ORIGINS=

# Desativa o acesso rápido de demonstração (true em produção)
DEMO_LOGIN_DISABLED=false

SECRET_KEY=troque-esta-chave
PORT=3000

# --- Entrega com respaldo legal (checkout no posto) ---
# Chave do HMAC (código de confirmação, CPF, recibo). Use um valor forte e NÃO o altere depois.
DELIVERY_HMAC_KEY=
# E-mail do código de confirmação. Sem SMTP_HOST o e-mail é impresso no console do servidor (desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Esqueceram AI <no-reply@seudominio.com>
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_BACKEND=
# Se true, itens em pontos de coleta só podem ser devolvidos pelo formulário de entrega (com termo).
DELIVERY_REQUIRE_CHECKOUT=false

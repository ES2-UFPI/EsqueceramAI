# Backend / Render
PORT=10000
APP_BASE_URL=http://localhost:10000
SECRET_KEY=troque-por-um-segredo-aleatorio
# Chave dedicada para hash das respostas de posse (se omitida, usa SECRET_KEY)
CLAIM_HMAC_KEY=
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEUPROJETO.supabase.co:5432/postgres
FRONTEND_ORIGIN=http://localhost:10000
# Para múltiplas origens, separe por vírgula. Não use * em produção.
CORS_ORIGINS=http://localhost:10000

# Supabase Storage: somente o backend usa a service role key.
SUPABASE_URL=https://SEUPROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_nao_versionar
SUPABASE_STORAGE_BUCKET=item-images

# E-mail/entrega (no Render gratuito, use porta 2525)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Esqueceram AI <no-reply@seu-dominio-verificado>
SMTP_STARTTLS=true

# Entrega com termo obrigatório antes de marcar como DELIVERED (opcional)
DELIVERY_REQUIRE_CHECKOUT=false

# Rotina diária de validade (US08): prazo de guarda em dias (padrão 90)
STORAGE_RETENTION_DAYS=90

# Análise visual de fotos por IA (US12 - opcional; Gemini Vision API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

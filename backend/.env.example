PORT=5000
FRONTEND_ORIGIN=http://localhost:8080
# Use no seu .env:
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/esqueceramai
DATABASE_URL=postgresql://postgres:senha@db.projeto.supabase.co:5432/postgres
# Diretório onde as imagens enviadas são gravadas
UPLOAD_DIR=./storage
# Usuário usado como autor dos itens enquanto não há autenticação
EMAIL_USUARIO_PADRAO=anonimo@esqueceram.ai
MAX_UPLOAD_BYTES=5242880

# Use "supabase" for the no-cost MVP storage path.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-chave-apenas-no-backend
SUPABASE_STORAGE_BUCKET=item-images

# Only required when STORAGE_PROVIDER=firebase.
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
FIREBASE_CREDENTIALS_JSON={"type":"service_account"}
